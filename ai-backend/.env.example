# PASC Region J AI Backend - Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (required for AI features - not needed for basic echo test)
OPENAI_API_KEY=sk-your-api-key-here

# Database connection (for future RAG integration)
DATABASE_SERVER=your-server.dailyrazor.com
DATABASE_NAME=PASC_RegionJ
DATABASE_USER=readonly_user
DATABASE_PASSWORD=secure_password

# CORS allowed origins (comma-separated, defaults are built into main.py)
# ALLOWED_ORIGINS=https://pascregionj.com,http://localhost:4200

# Server configuration
HOST=0.0.0.0
PORT=8000
